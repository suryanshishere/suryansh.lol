{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "suryansh-portfolio",
  "account_id": "dde2a53b8bb4d3259e14ee30b7c560e2",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "dev": { "host": "localhost:8787", "port": 8787, "local_protocol": "http", "upstream_protocol": "http" },
  "routes": [
    { "pattern": "suryansh.lol/*", "zone_id": "5ccb0e9bdfc3993c94bb1eb2a68c1d23" },
    { "pattern": "www.suryansh.lol/*", "zone_id": "5ccb0e9bdfc3993c94bb1eb2a68c1d23" }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/", "/admin", "/admin/"]
  },
  "placement": { "mode": "smart" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "APP_ENV": "production",
    "SITE_URL": "https://suryansh.lol",
    "ADMIN_EMAIL": "heresuryanshsingh@gmail.com",
    "MONGODB_DB": "suryansh_portfolio",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "MAIL_FROM": "governmentninjacontact@gmail.com"
  }
}
